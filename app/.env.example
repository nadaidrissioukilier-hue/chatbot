# =========================================================================
# ENTRAIDE.MA — MVP localhost (tout sur ce PC, pas de split VM1/VM2)
# Copier ce fichier vers .env et renseigner les valeurs réelles.
# =========================================================================

# === Neo4j ===
NEO4J_URI=bolt://localhost:27687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# === Qdrant — collection unique, dense+sparse nommés ===
QDRANT_HOST=localhost
QDRANT_PORT=26333
QDRANT_COLLECTION=entraide_mvp
QDRANT_DENSE_VECTOR_NAME=dense
QDRANT_SPARSE_VECTOR_NAME=sparse

# === Redis ===
REDIS_HOST=localhost
REDIS_PORT=26379
REDIS_DB=0
REDIS_PASSWORD=
CACHE_TTL=3600
REDIS_MAXMEMORY=512mb

# === Llama.cpp — serveur local (Qwen2.5-7B-Instruct GGUF) ===
LLAMACPP_URL=http://localhost:28080
LLAMACPP_MODEL=qwen2.5-7b-instruct-q4_k_m
LLAMACPP_TIMEOUT=420

# === FastAPI ===
API_HOST=0.0.0.0
API_PORT=8000

# === Embeddings (DOIT matcher le modèle utilisé à l'indexation : BGE-M3) ===
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIM=1024

# === Reranker ===
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BATCH_SIZE=32

# === Retrieval Params ===
TOP_K_DENSE=50
TOP_K_SPARSE=50
TOP_K_GRAPH=20
TOP_K_RERANK=10
RRF_K=60

# === Poids de fusion métier (doivent sommer à 1.0) ===
WEIGHT_RRF=0.35
WEIGHT_OFFRE=0.25
WEIGHT_POPULATION=0.25
WEIGHT_GEO=0.15

# === Pénalités métier ===
PENALTY_EPS=0.70
PENALTY_NO_POP=0.85
PENALTY_POP_MISMATCH=0.55

# === Sécurité / Auth ===
API_KEY_WIDGET=changeme
JWT_SECRET=changeme-generate-a-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=

# === CORS ===
ALLOWED_ORIGINS=*

# === Monitoring ===
ENABLE_METRICS=true
LOG_LEVEL=INFO
